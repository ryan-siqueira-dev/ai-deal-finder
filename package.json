{
  "name": "ai-deal-finder",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Self-hosted multi-marketplace deal discovery and analysis service",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:xvfb": "xvfb-run -a -s \"-screen 0 1920x1080x24\" node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "facebook:login": "tsx src/cli/facebook-login.ts",
    "olx:login": "tsx src/cli/olx-login.ts",
    "mercadolivre:login": "tsx src/cli/mercadolivre-login.ts",
    "mercadolivre:web-login": "tsx src/cli/mercadolivre-web-login.ts",
    "telegram:configure": "tsx src/cli/telegram-configure.ts",
    "providers:list": "tsx src/cli/providers.ts list",
    "provider:test": "tsx src/cli/providers.ts test",
    "search:create": "tsx src/cli/searches.ts create",
    "search:list": "tsx src/cli/searches.ts list",
    "search:run": "tsx src/cli/searches.ts run",
    "listings:recent": "tsx src/cli/listings.ts recent",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "dotenv": "^17.2.2",
    "node-cron": "^4.2.1",
    "pino": "^9.9.4",
    "playwright": "1.62.1",
    "prisma": "6.19.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
