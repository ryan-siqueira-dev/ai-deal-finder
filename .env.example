DATABASE_URL=postgresql://deal_finder:SUBSTITUA_POR_UMA_SENHA_FORTE@localhost:5433/deal_finder?schema=public
POSTGRES_PORT=5433
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
# UID/GID do usuário do host que possui ./data e ./.runtime (rode: id -u; id -g).
APP_UID=1000
APP_GID=1000

FACEBOOK_ENABLED=false
FACEBOOK_STORAGE_STATE_PATH=./data/facebook-session.json
FACEBOOK_MAX_LISTINGS_PER_RUN=5
FACEBOOK_HEADLESS=true

OLX_ENABLED=false
OLX_STORAGE_STATE_PATH=./data/olx-session.json
OLX_MAX_LISTINGS_PER_RUN=5
OLX_HEADLESS=true

MERCADOLIVRE_ENABLED=false
# web = coleta experimental somente com autorização; api = integração restrita para apps/contas elegíveis.
MERCADOLIVRE_MODE=web
MERCADOLIVRE_ACCESS_TOKEN=
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=
MERCADOLIVRE_TOKEN_PATH=./data/mercadolivre-oauth.json
MERCADOLIVRE_WEB_PROFILE_PATH=./data/mercadolivre-web-profile
MERCADOLIVRE_WEB_STORAGE_STATE_PATH=./data/mercadolivre-web-session.json
MERCADOLIVRE_WEB_HEADLESS=true
MERCADOLIVRE_MAX_LISTINGS_PER_RUN=5

LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_EXTRACTION_MODEL=qwen/qwen3.7-flash
LLM_ANALYSIS_MODEL=deepseek/deepseek-v4-flash
LLM_MAX_OUTPUT_TOKENS=800
LLM_REASONING_EFFORT=none

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=info
SCHEDULER_ENABLED=true
PROVIDER_REQUEST_TIMEOUT_MS=30000
LLM_REQUEST_TIMEOUT_MS=90000
DETAIL_FETCH_CONCURRENCY=2
COMPARABLE_MAX_AGE_DAYS=30
STORE_RAW_PROVIDER_DATA=false
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

VNC_ENABLED=false
# Preferred: add a read-only Docker secret mount and set its container path here.
# Example: /run/secrets/vnc_password. The file's first line takes priority over VNC_PASSWORD.
VNC_PASSWORD_FILE=
# Fallback only. Classic RFB accepts exactly 8 printable ASCII characters and is not encrypted.
VNC_PASSWORD=
VNC_PORT=5900
# Covers the two-call LLM validation/repair path at the maximum request timeout.
APP_STOP_GRACE_PERIOD=21m
